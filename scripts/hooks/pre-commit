#!/bin/bash
# Pre-commit hook to prevent committing hardcoded DEVELOPMENT_TEAM
# See CLAUDE.md for rationale

PROJECT_FILE="EnglishLearnApp/EnglishLearnApp.xcodeproj/project.pbxproj"

# Check if project.pbxproj is being committed
if git diff --cached --name-only | grep -q "$PROJECT_FILE"; then
  # Check for hardcoded DEVELOPMENT_TEAM (not using variable reference)
  if git diff --cached "$PROJECT_FILE" | grep -E '^\+.*DEVELOPMENT_TEAM = [^"$]' > /dev/null; then
    echo "❌ Error: DEVELOPMENT_TEAM must use variable reference"
    echo ""
    echo "Found hardcoded DEVELOPMENT_TEAM in $PROJECT_FILE"
    echo ""
    echo "Expected:  DEVELOPMENT_TEAM = \"\$(DEVELOPMENT_TEAM)\";"
    echo ""
    echo "Fix with:"
    echo "  sed -i '' 's/DEVELOPMENT_TEAM = [^;]*;/DEVELOPMENT_TEAM = \"\$(DEVELOPMENT_TEAM)\";/g' $PROJECT_FILE"
    echo ""
    echo "See CLAUDE.md for details."
    exit 1
  fi
fi

exit 0
