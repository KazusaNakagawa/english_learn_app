VITE_APP_VERSION=0.1.0
VITE_APP_ENV=poc

# VOICEVOX endpoint. Leave it empty to use the browser's Web Speech only.
#
# Local Docker engine, no key needed (see docs/web/local-voicevox.md):
# VITE_VOICEVOX_ENDPOINT_POC=http://127.0.0.1:50021
#
# AWS Lambda (poc environment), needs the API key below:
VITE_VOICEVOX_ENDPOINT_POC=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com
VITE_VOICEVOX_API_KEY_POC=your-api-key-here
