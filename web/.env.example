VITE_APP_VERSION=0.1.0
VITE_APP_ENV=poc

# Default VOICEVOX endpoint, used while the endpoint field in Settings is empty.
# Settings can name another endpoint at runtime. The key below is sent only to
# this endpoint. Empty endpoint here and in Settings means Web Speech only.
VITE_VOICEVOX_ENDPOINT_POC=
VITE_VOICEVOX_API_KEY_POC=

# Pick one of these by setting the two lines above.
#
# Local Docker engine, no key (see docs/web/local-voicevox.md):
#   VITE_VOICEVOX_ENDPOINT_POC=http://127.0.0.1:50021
#
# AWS Lambda (poc environment), key required:
#   VITE_VOICEVOX_ENDPOINT_POC=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com
#   VITE_VOICEVOX_API_KEY_POC=your-api-key-here
