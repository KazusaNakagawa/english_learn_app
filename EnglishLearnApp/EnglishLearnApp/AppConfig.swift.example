/// Application-level configuration constants.
///
/// Set voicevoxBaseURL to your deployed API Gateway endpoint.
/// This file is listed in .gitignore and should not be committed with real values.
///
/// Setup:
///   1. Copy AppConfig.swift.example to AppConfig.swift (if not already done)
///   2. Replace the placeholder URL with your actual API Gateway endpoint
enum AppConfig {
    /// Base URL for the VOICEVOX engine API (no trailing slash).
    /// Replace with your actual API Gateway endpoint after deploying the CDK stack.
    static let voicevoxBaseURL = "https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com"
}
